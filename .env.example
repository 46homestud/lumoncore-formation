# Stripe (dashboard Stripe > Développeurs > Clés API) — commencer avec les clés de TEST (sk_test_...)
STRIPE_SECRET_KEY=
# Secret du webhook (dashboard Stripe > Webhooks, ou `stripe listen` en local)
STRIPE_WEBHOOK_SECRET=
# Optionnel : id d'un prix créé dans Stripe (sinon 50 € via FORMATION_PRICE_CENTS)
STRIPE_PRICE_ID=
FORMATION_PRICE_CENTS=5000

# Resend (envoi de l'email avec le lien)
RESEND_API_KEY=
EMAIL_FROM="LUMONCORE <method@lumoncorestudio.com>"

# Secret aléatoire pour signer les liens de téléchargement (openssl rand -base64 32)
DOWNLOAD_SECRET=

# Adresse publique du site
SITE_URL=https://lumoncorestudio.com
